{
  "name": "strata-dlis",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "install:ci": "pnpm install --frozen-lockfile",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json --local --persist-to .wrangler/state",
    "lint": "eslint . --max-warnings=0",
    "db:generate": "drizzle-kit generate",
    "test": "node --test tests/*.test.mjs",
    "test:performance": "node tests/performance.mjs",
    "test:integration": "node tests/integration.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "node scripts/check-deploy.mjs && wrangler deploy --config dist/server/wrangler.json",
    "test:database": "python3 tests/database.py && python3 tests/migration.py && python3 tests/model-database.py && python3 tests/catalog-migration.py",
    "test:browser:serve": "vite --config tests/browser/vite.config.ts",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test:phase3": "node tests/run-browser.mjs tests/phase3-browser.mjs",
    "test:phase2": "node tests/phase2-browser.mjs",
    "test:browser": "node tests/run-browser.mjs",
    "test:ssr": "node tests/ssr.mjs",
    "test:browser:scientific": "node tests/run-browser.mjs tests/scientific-browser.mjs",
    "test:browser:real": "node tests/run-browser.mjs tests/real-browser.mjs",
    "test:python": "python3 -m unittest discover -s science -p test_science.py",
    "test:reference": "python3 scripts/verify-reference.py",
    "test:browser:publications": "node tests/run-browser.mjs tests/publications-browser.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "test:ui-controls": "node tests/ui-controls.mjs",
    "test:dev-startup": "node tests/dev-startup.mjs",
    "setup": "npm exec --yes --package=pnpm@11.25.0 -- pnpm install --frozen-lockfile",
    "predev": "npm run setup",
    "preseed": "npm run setup",
    "seed": "node scripts/seed.mjs",
    "local": "node scripts/local.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:seed": "node tests/seed.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "axe-core": "4.11.4",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "jsdom": "27.0.1",
    "playwright": "1.62.1",
    "prettier": "^3.9.7",
    "react-server-dom-webpack": "19.2.9",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.1.6",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
