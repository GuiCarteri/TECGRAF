{
  "name": "STRATA — Node 24 / Python",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "node",
  "forwardPorts": [
    5173
  ],
  "portsAttributes": {
    "5173": {
      "label": "STRATA local",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "pnpm --dir strata-dlis install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-python.python"
      ],
      "settings": {
        "typescript.tsdk": "strata-dlis/node_modules/typescript/lib",
        "terminal.integrated.enablePersistentSessions": false,
        "task.allowAutomaticTasks": "off",
        "remote.autoForwardPorts": false,
        "remote.restoreForwardedPorts": false
      }
    }
  }
}
